{
  "name": "gitflare-web-prod",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": false
  },
  "vars": {
    "LOG_LEVEL": "warn",
    "SITE_URL": "https://git.outtw.com",
    "VITE_BETTER_AUTH_URL": "https://git.outtw.com",
    "BETTER_AUTH_SECRET": "af7889313822c135304149f9bb264d644ed97b5033026742695d5340333e7e36"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "Repo"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "ca21121f-b43c-4aa9-88b3-68c3d6220151",
      "database_name": "gitflare-db",
      "migrations_dir": "./migrations",
      "preview_database_id": "ca21121f-b43c-4aa9-88b3-68c3d6220151"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repo"]
    }
  ]
}
